---
import { getNavigation } from '../data/navigation';
import { site } from '../data/site';
import { homeHref, ui, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
  // Adresse de la même page dans l'autre langue.
  translationHref: string;
}

const { locale, translationHref } = Astro.props;
const t = ui[locale];
const otherLocale = locale === 'fr' ? 'en' : 'fr';
const nav = await getNavigation(locale);
const current = Astro.url.pathname.replace(/\/?$/, '/');
const isActive = (href: string) => current.startsWith(href);
---

<header class="site-header">
  <div class="container bar">
    <a class="brand" href={homeHref(locale)} aria-label={`${site.name}, ${t.home}`}>
      {
        site.logo ? (
          <img class="logo-img" src={site.logo} alt="" width="48" height="48" />
        ) : (
          <span class="logo" aria-hidden="true">XL</span>
        )
      }
      <span class="brand-name">
        <span class="name-full">{site.name}</span>
        <span class="name-short" aria-hidden="true">{site.shortName}</span>
      </span>
    </a>

    <a class="lang" href={translationHref} hreflang={otherLocale} lang={otherLocale}>
      <span aria-hidden="true">{otherLocale.toUpperCase()}</span>
      <span class="visually-hidden">{t.otherLanguage}</span>
    </a>

    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="main-nav">
      <span class="menu-icon" aria-hidden="true"></span>
      <span class="visually-hidden">{t.menu}</span>
    </button>

    <nav id="main-nav" class="main-nav" aria-label={t.mainNav}>
      <ul class="nav-list">
        {
          nav.map((section, i) => (
            <li class:list={['nav-item', { active: isActive(section.href) }]}>
              <div class="nav-row">
                <a href={section.href} aria-current={current === section.href ? 'page' : undefined}>
                  {section.label}
                </a>
                {section.children.length > 0 && (
                  <button
                    class="submenu-toggle"
                    type="button"
                    aria-expanded="false"
                    aria-controls={`submenu-${i}`}
                  >
                    <span class="visually-hidden">{t.submenu} {section.label}</span>
                    <span class="chevron" aria-hidden="true" />
                  </button>
                )}
              </div>
              {section.children.length > 0 && (
                <ul class="submenu" id={`submenu-${i}`}>
                  {section.children.map((child) => (
                    <li>
                      <a href={child.href} aria-current={current === child.href ? 'page' : undefined}>
                        {child.label}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<script>
  const header = document.querySelector('.site-header');
  const menuToggle = header?.querySelector<HTMLButtonElement>('.menu-toggle');

  menuToggle?.addEventListener('click', () => {
    const open = menuToggle.getAttribute('aria-expanded') !== 'true';
    menuToggle.setAttribute('aria-expanded', String(open));
    header?.classList.toggle('nav-open', open);
    document.body.classList.toggle('no-scroll', open);
  });

  header?.querySelectorAll<HTMLButtonElement>('.submenu-toggle').forEach((button) => {
    button.addEventListener('click', () => {
      const open = button.getAttribute('aria-expanded') !== 'true';
      button.setAttribute('aria-expanded', String(open));
      button.closest('.nav-item')?.classList.toggle('submenu-open', open);
    });
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && header?.classList.contains('nav-open')) {
      menuToggle?.click();
      menuToggle?.focus();
    }
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--color-bg);
    color: var(--color-primary);
    border-bottom: 3px solid var(--color-primary);
  }

  .bar {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-height: var(--header-height);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    color: inherit;
    text-decoration: none;
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 1.2rem;
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }

  .logo {
    display: grid;
    place-items: center;
    width: 2.4rem;
    height: 2.4rem;
    border-radius: 50%;
    background: var(--color-primary);
    color: var(--color-primary-contrast);
    font-weight: 800;
    font-size: 0.95rem;
  }

  .name-full {
    display: none;
  }

  @media (min-width: 420px) {
    .name-full {
      display: inline;
    }

    .name-short {
      display: none;
    }
  }

  .logo-img {
    width: auto;
    height: 2.75rem;
  }

  .lang {
    margin-left: auto;
    padding: 0.4rem 0.6rem;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    color: inherit;
    font-size: 0.85rem;
    font-weight: 700;
    text-decoration: none;
  }

  .menu-toggle {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    margin-right: -0.5rem;
    border: 0;
    background: none;
    color: inherit;
    cursor: pointer;
  }

  .menu-icon,
  .menu-icon::before,
  .menu-icon::after {
    display: block;
    width: 1.4rem;
    height: 2px;
    background: currentColor;
    transition: transform 0.2s, background 0.2s;
  }

  .menu-icon {
    position: relative;
  }

  .menu-icon::before,
  .menu-icon::after {
    content: '';
    position: absolute;
  }

  .menu-icon::before {
    top: -7px;
  }

  .menu-icon::after {
    top: 7px;
  }

  .nav-open .menu-icon {
    background: transparent;
  }

  .nav-open .menu-icon::before {
    transform: translateY(7px) rotate(45deg);
  }

  .nav-open .menu-icon::after {
    transform: translateY(-7px) rotate(-45deg);
  }

  /* Mobile : menu plein écran sous l'en-tête, sous-menus en accordéon. */
  .main-nav {
    display: none;
    position: fixed;
    inset: var(--header-height) 0 0 0;
    overflow-y: auto;
    background: var(--color-bg);
    padding-bottom: 2rem;
  }

  .nav-open .main-nav {
    display: block;
  }

  .nav-list,
  .submenu {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-item {
    border-top: 1px solid var(--color-border);
  }

  .nav-row {
    display: flex;
    align-items: stretch;
  }

  .nav-row a {
    flex: 1;
    padding: 0.9rem var(--gutter);
    color: inherit;
    text-decoration: none;
    font-weight: 600;
    font-size: 1.1rem;
  }

  .active > .nav-row a {
    font-weight: 700;
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.35em;
  }

  .submenu-toggle {
    width: 3.5rem;
    border: 0;
    border-left: 1px solid rgb(255 255 255 / 0.12);
    background: none;
    color: inherit;
    cursor: pointer;
  }

  .chevron {
    display: inline-block;
    width: 0.6rem;
    height: 0.6rem;
    border-right: 2px solid currentColor;
    border-bottom: 2px solid currentColor;
    transform: rotate(45deg) translateY(-25%);
    transition: transform 0.2s;
  }

  .submenu-open .chevron {
    transform: rotate(-135deg) translateY(-25%);
  }

  .submenu {
    display: none;
    padding-bottom: 0.5rem;
    background: var(--color-surface);
  }

  .submenu-open .submenu {
    display: block;
  }

  .submenu a {
    display: block;
    padding: 0.6rem calc(var(--gutter) + 1rem);
    color: inherit;
    text-decoration: none;
  }

  .submenu a[aria-current='page'] {
    font-weight: 700;
  }

  /* Bureau : barre horizontale, sous-menus déroulants au survol ou au focus. */
  @media (min-width: 960px) {
    .menu-toggle {
      display: none;
    }

    .lang {
      order: 2;
      margin-left: 0.75rem;
    }

    .main-nav,
    .nav-open .main-nav {
      display: block;
      margin-left: auto;
      position: static;
      overflow: visible;
      padding: 0;
      background: none;
    }

    .nav-list {
      display: flex;
      gap: 0.25rem;
    }

    .nav-item {
      position: relative;
      border: 0;
    }

    .nav-row a {
      padding: 0.5rem 0.7rem;
      font-size: 0.98rem;
      border-radius: 6px;
    }

    .nav-row a:hover {
      background: var(--color-surface);
    }

    .submenu-toggle {
      display: none;
    }

    .submenu {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      min-width: 15rem;
      padding: 0.5rem 0;
      background: var(--color-bg);
      color: var(--color-text);
      border-radius: var(--radius);
      box-shadow: 0 12px 32px rgb(0 0 0 / 0.18);
    }

    .nav-item:hover .submenu,
    .nav-item:focus-within .submenu {
      display: block;
    }

    .submenu a {
      padding: 0.45rem 1rem;
    }

    .submenu a:hover {
      background: var(--color-surface);
    }

    .submenu a[aria-current='page'] {
      color: var(--color-primary);
      font-weight: 600;
    }
  }
</style>
