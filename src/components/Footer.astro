---
import MainSponsor from './MainSponsor.astro';
import { funders, mainSponsors, partnersHref, site } from '../data/site';
import { ui, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = ui[locale];
const privacyHref = locale === 'fr' ? '/confidentialite/' : '/en/privacy/';
const contactHref = locale === 'fr' ? '/contact/' : '/en/contact/';

const socials = [
  {
    label: 'Facebook',
    href: site.social.facebook,
    icon: 'M14 8h3V4h-3c-2.8 0-4 1.7-4 4.2V10H7v4h3v10h4V14h3l.5-4H14V8.6c0-.4.3-.6.6-.6Z',
  },
  {
    label: 'Instagram',
    href: site.social.instagram,
    icon: 'M12 7.2a4.8 4.8 0 1 0 0 9.6 4.8 4.8 0 0 0 0-9.6Zm0 7.8a3 3 0 1 1 0-6 3 3 0 0 1 0 6Zm5-9.2a1.1 1.1 0 1 0 0 2.2 1.1 1.1 0 0 0 0-2.2ZM12 2c-2.7 0-3 0-4.1.1C4.3 2.3 2.3 4.3 2.1 7.9 2 9 2 9.3 2 12s0 3 .1 4.1c.2 3.6 2.2 5.6 5.8 5.8 1.1.1 1.4.1 4.1.1s3 0 4.1-.1c3.6-.2 5.6-2.2 5.8-5.8.1-1.1.1-1.4.1-4.1s0-3-.1-4.1c-.2-3.6-2.2-5.6-5.8-5.8C15 2 14.7 2 12 2Zm0 1.8c2.7 0 3 0 4 .1 2.6.1 3.9 1.4 4 4 .1 1 .1 1.3.1 4s0 3-.1 4c-.1 2.6-1.4 3.9-4 4-1 .1-1.3.1-4 .1s-3 0-4-.1c-2.6-.1-3.9-1.4-4-4C3.9 15 3.9 14.7 3.9 12s0-3 .1-4c.1-2.6 1.4-3.9 4-4 1-.1 1.3-.1 4-.1Z',
  },
  {
    label: 'WhatsApp',
    href: site.social.whatsapp,
    icon: 'M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.2-.4.7-1.4.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.8 11.8 11.8 0 0 0 4.6 4c1.7.7 2.3.8 3.2.7.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.2-1.2l-.4-.3Z',
  },
];
---

<footer class="site-footer">
  {
    mainSponsors.length > 0 && (
      <div class="container sponsors">
        <MainSponsor locale={locale} />
        <a href={partnersHref}>{t.allPartners} →</a>
      </div>
    )
  }
  <div class="container grid">
    <div>
      <p class="name">{site.name}</p>
      <address>
        {site.address}<br />
        <a href={`mailto:${site.email}`}>{site.email}</a>
      </address>
      <p><a href={contactHref}>Contact</a> · <a href={privacyHref}>{t.privacy}</a></p>
    </div>
    <div>
      <p class="name">{t.followUs}</p>
      <ul class="socials">
        {
          socials.map((s) => (
            <li>
              <a href={s.href} aria-label={s.label}>
                <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true">
                  <path d={s.icon} fill="currentColor" />
                </svg>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
  <div class="container funders">
    <p class="name">{t.funders}</p>
    <ul>
      {funders.map((f) => <li>{f.name}</li>)}
    </ul>
  </div>
  <p class="container copy">© {new Date().getFullYear()} {site.name} ASBL</p>
</footer>

<style>
  .site-footer {
    margin-top: 3rem;
    padding-block: 2rem 1rem;
    background: var(--color-primary);
    color: var(--color-primary-contrast);
  }

  .sponsors {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid rgb(255 255 255 / 0.15);
  }

  .grid {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
  }

  .name {
    margin: 0 0 0.5rem;
    font-weight: 700;
  }

  address {
    font-style: normal;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  a {
    color: inherit;
  }

  .socials a {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.12);
  }

  .socials a:hover {
    background: rgb(255 255 255 / 0.22);
  }

  .funders {
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgb(255 255 255 / 0.15);
  }

  .funders li {
    padding: 0.4rem 0.8rem;
    border-radius: 6px;
    background: rgb(255 255 255 / 0.95);
    color: var(--color-primary);
    font-size: 0.85rem;
    font-weight: 600;
  }

  .copy {
    margin-top: 1.5rem;
    font-size: 0.85rem;
    opacity: 0.75;
  }
</style>
