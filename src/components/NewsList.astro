---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { dateFormat, type Locale } from '../i18n/ui';

interface Props {
  items: CollectionEntry<'news'>[];
  locale: Locale;
}

const { items, locale } = Astro.props;
---

<ul class="card-grid">
  {
    items.map((item) => (
      <li>
        <a class="card news" href={`/club/actus/${item.id}/`}>
          {item.data.image && (
            <Image src={item.data.image} alt={item.data.imageAlt ?? ''} widths={[400, 800]} sizes="(min-width: 960px) 22rem, 100vw" />
          )}
          <time datetime={item.data.date.toISOString()}>{dateFormat(locale, item.data.date)}</time>
          <h3>{item.data.title}</h3>
          <p>{item.data.description}</p>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .news img {
    display: block;
    width: calc(100% + 2.5rem);
    max-width: none;
    margin: -1.25rem -1.25rem 1rem;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: var(--radius) var(--radius) 0 0;
  }

  time {
    display: block;
    margin-bottom: 0.25rem;
    font-size: 0.85rem;
    color: var(--color-muted);
  }
</style>
