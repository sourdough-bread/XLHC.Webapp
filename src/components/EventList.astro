---
import type { CollectionEntry } from 'astro:content';
import { dateFormat, ui, type Locale } from '../i18n/ui';

interface Props {
  items: CollectionEntry<'events'>[] | CollectionEntry<'camps'>[];
  locale: Locale;
}

const { items, locale } = Astro.props;
const t = ui[locale];

const rows = items.map((item) => {
  const d = item.data;
  const start = 'startDate' in d ? d.startDate : d.date;
  const end = 'startDate' in d ? d.endDate : d.endDate;
  const short = { year: undefined } as const;
  const when = end && end.getTime() !== start.getTime()
    ? `${dateFormat(locale, start, short)} – ${dateFormat(locale, end)}`
    : dateFormat(locale, start, { weekday: 'long' });
  const details = 'startDate' in d ? [d.ages, d.price] : [d.location];
  const href = 'startDate' in d ? d.bookingUrl : d.signupUrl;
  return { id: item.id, title: d.title, summary: d.summary, when, end: end ?? start, details, href, isCamp: 'startDate' in d };
});
---

{
  rows.length === 0 ? (
    <p>{t.noItems}</p>
  ) : (
    <ul class="dated-list">
      {rows.map((row) => (
        <li data-end={row.end.toISOString()}>
          <p class="when">{row.when}</p>
          <h3>{row.title}</h3>
          {row.details.filter(Boolean).length > 0 && <p class="details">{row.details.filter(Boolean).join(' · ')}</p>}
          {row.summary && <p>{row.summary}</p>}
          {row.href && (
            <a class="button primary small" href={row.href}>
              {row.isCamp ? t.book : t.signup}
            </a>
          )}
        </li>
      ))}
    </ul>
  )
}

<script>
  // Masque les dates passées entre deux mises à jour du site.
  const today = new Date();
  today.setHours(0, 0, 0, 0);
  document.querySelectorAll<HTMLElement>('.dated-list [data-end]').forEach((item) => {
    if (new Date(item.dataset.end!) < today) item.hidden = true;
  });
</script>

<style>
  .dated-list {
    display: grid;
    gap: 1rem;
    padding: 0;
    list-style: none;
  }

  .dated-list li {
    padding: 1rem 1.25rem;
    border: 1px solid var(--color-border);
    border-left: 4px solid var(--color-accent);
    border-radius: var(--radius);
  }

  .dated-list p,
  .dated-list h3 {
    margin: 0 0 0.35rem;
  }

  .when {
    font-weight: 700;
    color: var(--color-primary);
  }

  .when::first-letter {
    text-transform: uppercase;
  }

  .details {
    color: var(--color-muted);
  }
</style>
