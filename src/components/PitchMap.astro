---
import type { Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
  compact?: boolean;
}

const { locale, compact = false } = Astro.props;

const copy = {
  fr: {
    title: 'Nous trouver',
    mapTitle: "Plan d'accès à l'Ixelles Hockey Club",
    tapHint: 'Touchez le plan pour lancer l’itinéraire',
    go: 'Y aller',
    entrances: [
      { id: 'top', label: 'Entrée haute', detail: 'Centre sportif', street: 'Rue Volta 18, 1050 Ixelles' },
      { id: 'bottom', label: 'Entrée basse', detail: 'Pétanque', street: 'Rue de Brebis 77, 1050 Ixelles' },
    ],
  },
  en: {
    title: 'Find us',
    mapTitle: 'Map of the Ixelles Hockey Club grounds',
    tapHint: 'Tap the map to start directions',
    go: 'Get directions',
    entrances: [
      { id: 'top', label: 'Top entrance', detail: 'Sports centre', street: 'Rue Volta 18, 1050 Ixelles' },
      { id: 'bottom', label: 'Bottom entrance', detail: 'Pétanque ground', street: 'Rue de Brebis 77, 1050 Ixelles' },
    ],
  },
}[locale];

// Clé inutile : l'embed « output=embed » et l'URL d'itinéraire fonctionnent sans API.
// Sur mobile, l'URL d'itinéraire ouvre l'application Maps native.
const embedUrl = (street: string) => `https://maps.google.com/maps?q=${encodeURIComponent(street)}&z=17&hl=${locale}&output=embed`;
const directionsUrl = (street: string) => `https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(street)}&travelmode=walking`;

const places = copy.entrances.map((e) => ({ ...e, embed: embedUrl(e.street), directions: directionsUrl(e.street) }));
const first = places[0];
---

<section class:list={['pitch-map', { compact }]} aria-labelledby="pitch-map-title">
  <h2 id="pitch-map-title">{copy.title}</h2>

  <div class="tabs" role="group" aria-label={copy.title}>
    {
      places.map((p, i) => (
        <button type="button" class="tab" aria-pressed={i === 0 ? 'true' : 'false'} data-embed={p.embed} data-directions={p.directions}>
          <strong>{p.label}</strong>
          <span>{p.street}</span>
        </button>
      ))
    }
  </div>

  <div class="frame">
    <iframe src={first.embed} title={copy.mapTitle} loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
    <!-- Surcouche : un toucher sur le plan lance l'itinéraire, au lieu de faire défiler la carte. -->
    <a class="tap" href={first.directions} target="_blank" rel="noopener" aria-label={`${copy.go} – ${first.street}`}>
      <span class="hint">{copy.tapHint}</span>
    </a>
  </div>

  <p class="go">
    <a class="button primary" href={first.directions} target="_blank" rel="noopener">{copy.go}</a>
  </p>
</section>

<script>
  document.querySelectorAll<HTMLElement>('.pitch-map').forEach((root) => {
    const iframe = root.querySelector<HTMLIFrameElement>('iframe')!;
    const links = root.querySelectorAll<HTMLAnchorElement>('.tap, .go a');
    const street = (url: string) => decodeURIComponent(url.split(/[?&](?:q|destination)=/)[1].split('&')[0]);
    root.querySelectorAll<HTMLButtonElement>('.tab').forEach((tab) => {
      tab.addEventListener('click', () => {
        root.querySelectorAll('.tab').forEach((t) => t.setAttribute('aria-pressed', String(t === tab)));
        iframe.src = tab.dataset.embed!;
        links.forEach((a) => {
          a.href = tab.dataset.directions!;
          if (a.classList.contains('tap')) a.setAttribute('aria-label', `${a.getAttribute('aria-label')!.split(' – ')[0]} – ${street(tab.dataset.directions!)}`);
        });
      });
    });
  });
</script>

<style>
  .pitch-map {
    margin-top: 2.25rem;
  }

  .pitch-map h2 {
    margin-bottom: 0.75rem;
    color: var(--color-primary-dark);
    text-transform: uppercase;
  }

  .tabs {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.5rem;
    margin-bottom: 0.6rem;
  }

  .tab {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    padding: 0.55rem 0.7rem;
    border: 2px solid var(--color-border);
    border-radius: 12px;
    background: var(--color-bg);
    color: var(--color-text);
    font: inherit;
    font-size: 0.85rem;
    line-height: 1.25;
    text-align: left;
    cursor: pointer;
  }

  .tab span {
    color: var(--color-muted);
  }

  .tab[aria-pressed='true'] {
    border-color: var(--color-primary);
    background: var(--color-surface);
  }

  .frame {
    position: relative;
    height: clamp(16rem, 55vw, 26rem);
    overflow: hidden;
    border-radius: 18px;
    background: var(--color-surface);
  }

  .compact .frame {
    height: clamp(14rem, 50vw, 20rem);
  }

  iframe {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .tap {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    padding: 0.6rem;
    color: #fff;
    text-decoration: none;
  }

  .hint {
    padding: 0.3rem 0.8rem;
    border-radius: 999px;
    background: rgb(1 60 28 / 0.88);
    font-size: 0.8rem;
    font-weight: 700;
  }

  .go {
    margin: 0.75rem 0 0;
  }

  .go .button {
    width: 100%;
    text-align: center;
  }

  @media (min-width: 600px) {
    .go .button {
      width: auto;
    }
  }
</style>
