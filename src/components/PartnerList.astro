---
import SponsorLogo from './SponsorLogo.astro';
import { mainSponsors, otherPartners } from '../data/site';
---

{
  mainSponsors.length > 0 && (
    <ul class="logos main">
      {mainSponsors.map((p) => (
        <li>
          <SponsorLogo partner={p} />
        </li>
      ))}
    </ul>
  )
}
<ul class="logos">
  {
    otherPartners.map((p) => (
      <li>
        <SponsorLogo partner={p} />
      </li>
    ))
  }
</ul>

<style>
  .logos {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(9rem, 1fr));
    gap: 0.75rem;
    margin: 0 0 0.75rem;
    padding: 0;
    list-style: none;
  }

  .logos li {
    height: 6rem;
  }

  .logos.main {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
  }

  .logos.main li {
    height: 9rem;
  }

  @media (min-width: 640px) {
    .logos {
      grid-template-columns: repeat(auto-fill, minmax(11rem, 1fr));
    }
  }
</style>
