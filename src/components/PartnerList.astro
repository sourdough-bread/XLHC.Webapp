---
import { partners } from '../data/site';
---

<ul class="logos">
  {partners.map((p) => <li>{p.url ? <a href={p.url}>{p.name}</a> : p.name}</li>)}
</ul>

<style>
  .logos {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding: 0;
    list-style: none;
  }

  .logos li {
    padding: 0.5rem 0.9rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    color: var(--color-muted);
    font-weight: 600;
  }

  .logos a {
    color: inherit;
    text-decoration: none;
  }
</style>
