---
import BaseLayout from '../layouts/BaseLayout.astro';
import NewsList from '../components/NewsList.astro';
import { getNews } from '../data/news';
import { partners, pitch, site, supporters } from '../data/site';

const latestNews = (await getNews()).slice(0, 3);

const highlights = [
  { href: '/actu/', title: 'Actu', text: 'Les dernières nouvelles du club.' },
  { href: '/le-club/', title: 'Le Club', text: 'Notre histoire, nos valeurs, notre équipe.' },
  { href: '/juniors/', title: "L'école des jeunes", text: 'Le hockey pour les enfants et les ados.' },
  { href: '/seniors/', title: 'Les équipes seniors', text: 'Dames, messieurs et mixtes.' },
];
---

<BaseLayout>
  <section class="hero">
    <div class="container">
      <h1>Bienvenue à l'Ixelles Hockey Club</h1>
      <p class="lead">{site.tagline}. Des juniors aux seniors, tout le monde a sa place sur le terrain.</p>
      <div class="actions">
        <a class="button primary" href="/admin/demande-d-affiliation/">S'affilier au club</a>
        <a class="button" href="/sport/je-decouvre/">Je découvre le hockey</a>
      </div>
    </div>
  </section>

  <div class="container">
    <section class="pitch" data-status={pitch.status} aria-live="polite">
      <span class="dot" aria-hidden="true"></span>
      <p>
        <strong>État du terrain :</strong>{' '}{pitch.label}
        {pitch.note && <span class="note"> · {pitch.note}</span>}
      </p>
    </section>

    <section aria-labelledby="explorer">
      <h2 id="explorer" class="visually-hidden">Explorer le site</h2>
      <ul class="card-grid">
        {
          highlights.map((h) => (
            <li>
              <a class="card" href={h.href}>
                <h3>{h.title}</h3>
                <p>{h.text}</p>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    {
      latestNews.length > 0 && (
        <section aria-labelledby="dernieres-actus">
          <h2 id="dernieres-actus">Dernières actus</h2>
          <NewsList items={latestNews} />
          <p><a href="/actu/">Toutes les actualités →</a></p>
        </section>
      )
    }

    <section class="info" aria-labelledby="membres">
      <h2 id="membres">Rejoindre ou quitter le club</h2>
      <p>
        Pour vous inscrire ou inscrire vos enfants, consultez la page{' '}
        <a href="/admin/demande-d-affiliation/">Demande d'affiliation</a>. Pour quitter le club, rendez-vous sur la page{' '}
        <a href="/admin/desaffiliation/">Désaffiliation</a>.
      </p>
      <p>
        Rejoignez la <a href={site.social.whatsapp}>communauté WhatsApp</a> du club pour recevoir les annonces et accéder
        aux groupes de votre équipe. Suivez-nous aussi sur <a href={site.social.facebook} rel="noopener">Facebook</a>{' '}
        et <a href={site.social.instagram} rel="noopener">Instagram</a>.
      </p>
    </section>

    <section aria-labelledby="partenaires">
      <h2 id="partenaires">Nos partenaires</h2>
      <ul class="logos">
        {partners.map((p) => <li>{p.name}</li>)}
      </ul>
      <h2>Avec le soutien de</h2>
      <ul class="logos">
        {supporters.map((s) => <li>{s.name}</li>)}
      </ul>
    </section>
  </div>
</BaseLayout>

<style>
  .hero {
    padding-block: 2.5rem;
    background: linear-gradient(160deg, var(--color-primary) 0%, #17448f 100%);
    color: var(--color-primary-contrast);
  }

  .hero h1 {
    color: inherit;
  }

  .lead {
    max-width: 38rem;
    margin: 0 0 1.5rem;
    font-size: 1.15rem;
    opacity: 0.92;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .button {
    display: inline-flex;
    align-items: center;
    min-height: 2.9rem;
    padding: 0 1.25rem;
    border: 2px solid currentColor;
    border-radius: 999px;
    color: inherit;
    font-weight: 600;
    text-decoration: none;
  }

  .button.primary {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: var(--color-primary);
  }

  section {
    margin-top: 2rem;
  }

  .pitch {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 1rem;
    border-radius: var(--radius);
    background: var(--color-surface);
  }

  .pitch p {
    margin: 0;
  }

  .dot {
    flex: none;
    width: 0.8rem;
    height: 0.8rem;
    border-radius: 50%;
    background: var(--color-ok);
  }

  .pitch[data-status='warning'] .dot {
    background: var(--color-warning);
  }

  .pitch[data-status='closed'] .dot {
    background: var(--color-closed);
  }

  .note {
    color: var(--color-muted);
  }

  .info {
    max-width: 44rem;
  }

  .logos {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding: 0;
    list-style: none;
  }

  .logos li {
    padding: 0.5rem 0.9rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    color: var(--color-muted);
    font-weight: 600;
  }
</style>
