---
import BaseLayout from '../../layouts/BaseLayout.astro';
import NewsList from '../../components/NewsList.astro';
import { getNews } from '../../data/news';

const news = await getNews();
---

<BaseLayout title="Actualités" description="Les dernières nouvelles de l'Ixelles Hockey Club.">
  <div class="container page">
    <h1>Actualités</h1>
    {news.length > 0 ? <NewsList items={news} /> : <p>Pas encore d'actualités.</p>}
  </div>
</BaseLayout>
