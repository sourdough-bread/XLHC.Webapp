---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate, getNews } from '../../data/news';

export async function getStaticPaths() {
  const news = await getNews();
  return news.map((item) => ({ params: { slug: item.id }, props: { item } }));
}

const { item } = Astro.props;
const { Content } = await render(item);
---

<BaseLayout title={item.data.title} description={item.data.summary}>
  <article class="container page">
    <p class="breadcrumb"><a href="/actu/">Actu</a></p>
    <h1>{item.data.title}</h1>
    <p class="meta">
      <time datetime={item.data.date.toISOString()}>{formatDate(item.data.date)}</time>
    </p>
    <div class="prose">
      <Content />
    </div>
  </article>
</BaseLayout>

<style>
  .meta {
    margin-top: -0.5rem;
    color: var(--color-muted);
  }
</style>
